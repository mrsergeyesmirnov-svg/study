generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BarcodeStatus {
  POOL
  ASSIGNED
  SOLD
  VOID
}

enum ProductStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum SoldChannel {
  TELEGRAM
  OFFLINE
}

enum ProductSource {
  ADMIN
  CHANNEL_IMPORT
}

model Barcode {
  id         String        @id @default(cuid())
  code       String        @unique
  status     BarcodeStatus @default(POOL)
  batchId    String?
  productId  String?       @unique
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignedAt DateTime?
  soldAt     DateTime?
  createdAt  DateTime      @default(now())
}

model Product {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  brand              String?
  /// Catalog filter: outerwear | polo | pants | accessories | …
  category           String?
  size               String?
  conditionText      String?
  measurements       String?
  story              String?
  priceRub           Int
  costRub            Int?
  status             ProductStatus  @default(DRAFT)
  source             ProductSource  @default(ADMIN)
  soldChannel        SoldChannel?
  reservedUntil      DateTime?
  /// When set and status=DRAFT, scheduler publishes at this time (needs barcode + photos).
  publishAt          DateTime?
  channelMainId      String?
  channelStockId     String?
  /// Telegram channel that sourced this draft (CHANNEL_IMPORT).
  sourceChatId       String?
  sourceMessageId    String?
  sourceMediaGroupId String?
  /// Dedup key `${chatId}:${messageId}` for channel imports (avoids nullable composite unique).
  sourceKey          String?        @unique
  barcode            Barcode?
  images             ProductImage[]
  orderItems         OrderItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  soldAt             DateTime?

  @@index([status, publishAt])
  @@index([source, status])
  @@index([status, category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

/// Durable image storage (Railway disk is ephemeral — keep bytes in Postgres).
model MediaObject {
  id        String   @id @default(cuid())
  mimeType  String   @default("image/jpeg")
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

model Order {
  id               String      @id @default(cuid())
  telegramUserId   String
  telegramUsername String?
  status           OrderStatus @default(PENDING)
  totalRub         Int
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  priceRub  Int
}

model AdminUser {
  id             String   @id @default(cuid())
  telegramUserId String   @unique
  name           String?
  createdAt      DateTime @default(now())
}
